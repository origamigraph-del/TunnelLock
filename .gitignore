.gradle/
build/
local.properties
.idea/
*.iml
.DS_Store
captures/
.kotlin/

# Downloaded by CI (see .github/workflows/build.yml)
app/libs/*.aar

# Never commit the signing keystore or passwords (CI restores the keystore
# from the KEYSTORE_BASE64 secret; see .github/workflows/build.yml).
signing/*.jks
signing/*.keystore
signing/*.properties
SIGNING_PASSWORD*

# Built by CI from pinned sources (see native/build-openvpn.sh)
native/work/
native/out/
app/src/main/jniLibs/

# Emulator test output (see e2e/)
e2e/out/
__pycache__/
